#!/bin/bash
# Launch pi with pitrix agent directory
export PI_CODING_AGENT_DIR=~/.pi/agent-pitrix
export PI_PACKAGE_DIR=~/.pi/agent-pitrix-packages

# Fix node_modules symlink for current OS (handles macOS <-> Linux sync)
NODEMODULES_TARGET="$HOME/.pi/agent/extensions/node_modules"
NODEMODULES_LINK="$PI_CODING_AGENT_DIR/extensions/node_modules"
if [ -d "$NODEMODULES_TARGET" ]; then
    # Remove existing symlink/dir if wrong
    if [ -L "$NODEMODULES_LINK" ]; then
        CURRENT=$(readlink "$NODEMODULES_LINK")
        if [ "$CURRENT" != "$NODEMODULES_TARGET" ]; then
            rm "$NODEMODULES_LINK"
        fi
    fi
    # Create symlink if missing
    if [ ! -e "$NODEMODULES_LINK" ]; then
        ln -s "$NODEMODULES_TARGET" "$NODEMODULES_LINK"
    fi
fi

exec pi --theme ~/.pi/agent-pitrix/themes/matrix.json "$@"
