#!/usr/bin/env node
/**
 * aph — Agent Pitrix Headless CLI client
 *
 * Wraps pi --mode rpc with the agent-team-headless extension.
 * Sends prompts, streams output as plain text.
 *
 * Usage:
 *   aph "message"                  One-shot prompt
 *   aph --team web-audit "msg"     With team selection
 *   aph --model ocg2/ds-v4 "msg"   With model override
 *   aph -c "msg"                   Continue last session
 *   aph --no-session "msg"         Ephemeral
 *   aph --list-teams               List available teams
 */

const { spawn } = require("child_process");
const { existsSync, readFileSync, mkdirSync } = require("fs");
const { join, resolve } = require("path");
const { homedir } = require("os");
const { StringDecoder } = require("string_decoder");

const HOME = homedir();
const HEADLESS_DIR = join(HOME, ".pi", "agent-pitrix-headless");

// ── Parse Args ─────────────────────────────

const args = process.argv.slice(2);
let promptText = null;
let teamName = null;
let modelId = null;
let thinkingLevel = null;
let continueSession = false;
let noSession = false;
let listTeams = false;
let sessionPath = null;
let cwd = process.cwd();
let forkSession = null;
let verbose = false;

let i = 0;
while (i < args.length) {
  const arg = args[i];
  if (arg === "--team" || arg === "-t") {
    teamName = args[++i];
  } else if (arg === "--model" || arg === "-m") {
    modelId = args[++i];
  } else if (arg === "--thinking") {
    thinkingLevel = args[++i];
  } else if (arg === "-c" || arg === "--continue") {
    continueSession = true;
  } else if (arg === "--no-session") {
    noSession = true;
  } else if (arg === "--list-teams") {
    listTeams = true;
  } else if (arg === "--session") {
    sessionPath = args[++i];
  } else if (arg === "--fork") {
    forkSession = args[++i];
  } else if (arg === "-v" || arg === "--verbose") {
    verbose = true;
  } else if (arg === "--cwd" || arg === "-d") {
    cwd = resolve(args[++i]);
  } else if (arg === "-h" || arg === "--help") {
    console.log(`aph — Agent Pitrix Headless

Usage: aph [options] [message]

Options:
  -t, --team <name>     Select team (e.g. web-audit, full-ops, development)
  -m, --model <id>      Model override (e.g. ocg2/deepseek-v4-pro)
  --thinking <level>    Thinking level (off/minimal/low/medium/high/xhigh)
  -c, --continue        Continue most recent session
  --no-session          Ephemeral mode (don't save session)
  --session <path>      Use specific session file
  --fork <path|id>      Fork existing session
  --list-teams          List available teams and exit
  -d, --cwd <dir>       Working directory (default: current)
  -v, --verbose         Show pi stderr output

Examples:
  aph "Audit https://example.com"
  aph --team web-audit "Scan the web app"
  aph -c "Continue the previous audit"
  aph --list-teams`);
    process.exit(0);
  } else if (!arg.startsWith("-")) {
    promptText = arg;
  }
  i++;
}

// ── Find Pi ────────────────────────────────

function findPi() {
  const envPath = process.env.PI_PATH;
  if (envPath && existsSync(envPath)) return envPath;
  try {
    const { execSync } = require("child_process");
    const which = execSync("which pi", { encoding: "utf-8" }).trim();
    if (which && existsSync(which)) return which;
  } catch {}
  const paths = ["/opt/homebrew/bin/pi", "/usr/local/bin/pi", "/usr/bin/pi"];
  for (const p of paths) if (existsSync(p)) return p;
  // Try mise
  try {
    const { readdirSync } = require("fs");
    const miseDir = join(HOME, ".local", "share", "mise", "installs");
    if (existsSync(miseDir)) {
      for (const v of readdirSync(miseDir)) {
        const pi = join(miseDir, v, "bin", "pi");
        if (existsSync(pi)) return pi;
      }
    }
  } catch {}
  return "/opt/homebrew/bin/pi";
}

const PI = findPi();

// ── List Teams ─────────────────────────────

function readTeams() {
  const paths = [
    join(HEADLESS_DIR, "agents", "teams.yaml"),
    join(HOME, ".pi", "agent-pitrix", "agents", "teams.yaml"),
  ];
  for (const p of paths) {
    if (existsSync(p)) {
      try {
        const raw = readFileSync(p, "utf-8");
        const teams = {};
        let current = null;
        for (const line of raw.split("\n")) {
          const teamMatch = line.match(/^(\S[^:]*):$/);
          if (teamMatch) { current = teamMatch[1].trim(); teams[current] = []; continue; }
          const itemMatch = line.match(/^\s+-\s+(.+)$/);
          if (itemMatch && current) teams[current].push(itemMatch[1].trim());
        }
        return teams;
      } catch {}
    }
  }
  return {};
}

if (listTeams) {
  const teams = readTeams();
  if (Object.keys(teams).length === 0) {
    console.log("No teams found. Add teams.yaml to ~/.pi/agent-pitrix-headless/agents/");
    process.exit(1);
  }
  console.log("Available teams:");
  for (const [name, members] of Object.entries(teams)) {
    console.log(`  ${name}: ${members.join(", ")}`);
  }
  process.exit(0);
}

// ── Ensure sessions dir ─────────────────────

const sessionsDir = join(HEADLESS_DIR, "sessions");
if (!existsSync(sessionsDir)) mkdirSync(sessionsDir, { recursive: true });

// ── Find provider extensions (from main agent dir) ─

function findProviderExtensions() {
  const exts = [];
  const searchDirs = [
    join(HOME, ".pi", "agent", "git"),
    join(HOME, ".pi", "agent", "npm", "node_modules"),
  ];
  const commonEntryPoints = ["index.ts", "index.js", "kilo.ts", "provider.ts", "main.ts", "main.js"];

  for (const dir of searchDirs) {
    if (!existsSync(dir)) continue;
    try {
      const { readdirSync } = require("fs");
      for (const pkgName of readdirSync(dir)) {
        if (pkgName.startsWith(".")) continue;
        const pkgPath = join(dir, pkgName);
        if (!existsSync(pkgPath)) continue;
        // Check if it's a directory (git packages) or a package (npm)
        const stat = require("fs").statSync(pkgPath);
        if (!stat.isDirectory()) continue;
        
        for (const entry of commonEntryPoints) {
          const entryPath = join(pkgPath, entry);
          if (existsSync(entryPath)) {
            try {
              const content = readFileSync(entryPath, "utf-8");
              if (content.includes("registerProvider")) {
                exts.push(entryPath);
                break;
              }
            } catch {}
          }
        }
      }
    } catch {}
  }
  return exts;
}

const providerExts = findProviderExtensions();

// ── Build pi args ──────────────────────────

const piArgs = [
  "--mode", "rpc",
  "--no-context-files",
];

// Add provider extensions
for (const ext of providerExts) {
  piArgs.push("-e", ext);
}

// Add headless agent-team extension
piArgs.push("-e", join(HEADLESS_DIR, "extensions", "agent-team-headless.ts"));

if (noSession) {
  piArgs.push("--no-session");
} else if (sessionPath) {
  piArgs.push("--session", sessionPath);
} else if (forkSession) {
  piArgs.push("--fork", forkSession);
} else if (continueSession) {
  piArgs.push("-c");
} else {
  // Use headless sessions dir
  piArgs.push("--session-dir", sessionsDir);
}

if (modelId) {
  piArgs.push("--model", modelId);
}

if (thinkingLevel) {
  piArgs.push("--thinking", thinkingLevel);
}

// ── Spawn ───────────────────────────────────

const proc = spawn(PI, piArgs, {
  stdio: ["pipe", "pipe", "pipe"],
  cwd,
  env: {
    ...process.env,
    PI_CODING_AGENT_DIR: HEADLESS_DIR,
    ...(teamName ? { APH_TEAM: teamName } : {}),
  },
});

// ── JSONL reader (RPC-compliant, LF only) ───

function attachJsonlReader(stream, onLine) {
  const decoder = new StringDecoder("utf8");
  let buffer = "";

  stream.on("data", (chunk) => {
    buffer += typeof chunk === "string" ? chunk : decoder.write(chunk);

    while (true) {
      const newlineIndex = buffer.indexOf("\n");
      if (newlineIndex === -1) break;

      let line = buffer.slice(0, newlineIndex);
      buffer = buffer.slice(newlineIndex + 1);
      if (line.endsWith("\r")) line = line.slice(0, -1);
      if (line.trim()) {
        try {
          onLine(JSON.parse(line));
        } catch {}
      }
    }
  });
}

function send(cmd) {
  proc.stdin.write(JSON.stringify(cmd) + "\n");
}

let agentDone = false;
let hasPrompted = false;
let textStarted = false;
let extensionUiRequestPending = null; // stash first extension_ui_request id for auto-dismiss

attachJsonlReader(proc.stdout, (event) => {
  // Track agent lifecycle
  if (event.type === "agent_start") {
    // ready
  } else if (event.type === "agent_end") {
    agentDone = true;
    if (hasPrompted) {
      proc.stdin.end();
      // Let stderr drain, then exit
      setTimeout(() => { process.exit(event.messages?.some?.(m => m.stopReason === "error") ? 1 : 0); }, 100);
    }
  }

  // Stream text output
  if (event.type === "message_update") {
    const delta = event.assistantMessageEvent;
    if (delta?.type === "text_delta") {
      if (!textStarted) { textStarted = true; }
      process.stdout.write(delta.delta);
    } else if (delta?.type === "text_start") {
      textStarted = true;
    } else if (delta?.type === "text_end") {
      process.stdout.write("\n");
    }
    // Thinking blocks: show a brief indicator
    if (delta?.type === "thinking_start") {
      process.stderr.write("[thinking] ");
    } else if (delta?.type === "thinking_end") {
      process.stderr.write("\n");
    }
  }

  // Tool execution: show activity
  if (event.type === "tool_execution_start") {
    process.stderr.write(`[${event.toolName}…]\n`);
  }

  // Extension UI: team selection on startup
  if (event.type === "extension_ui_request") {
    // Auto-respond to any select/confirm that comes during startup
    // (e.g., the team selection dialog)
    if (!hasPrompted && event.method === "select") {
      // If user specified a team, try to find it in options
      if (teamName && event.options) {
        const match = event.options.find(o =>
          o.toLowerCase().startsWith(teamName.toLowerCase()) ||
          o.includes(teamName)
        );
        if (match) {
          send({ type: "extension_ui_response", id: event.id, value: match });
        } else {
          // Pick first option
          send({ type: "extension_ui_response", id: event.id, value: event.options[0] });
        }
      } else {
        // Pick first option (default team)
        send({ type: "extension_ui_response", id: event.id, value: event.options[0] });
      }
      return;
    }

    // For notify: log to stderr
    if (event.method === "notify") {
      const prefix = event.notifyType === "error" ? "✗" : event.notifyType === "warning" ? "⚠" : "ℹ";
      process.stderr.write(`${prefix} ${event.message}\n`);
      return;
    }

    // For setWidget: show status on stderr
    if (event.method === "setWidget" && event.widgetLines) {
      process.stderr.write(`\n${event.widgetLines.join("\n")}\n`);
      return;
    }

    // For other extension UI requests (select, confirm, input during session):
    // log to stderr and auto-cancel
    if (["select", "confirm", "input", "editor"].includes(event.method)) {
      process.stderr.write(`[ui: ${event.method}] ${event.title || ""} (auto-cancelled in headless mode)\n`);
      send({ type: "extension_ui_response", id: event.id, cancelled: true });
      return;
    }
  }

  // Queue updates
  if (event.type === "queue_update") {
    if (event.steering?.length || event.followUp?.length) {
      process.stderr.write(`[queued: ${(event.steering?.length || 0) + (event.followUp?.length || 0)} messages]\n`);
    }
  }

  // Errors
  if (event.type === "extension_error") {
    process.stderr.write(`[extension error] ${event.error}\n`);
  }

  // On response to our prompt, track that we've prompted
  if (event.type === "response" && event.command === "prompt") {
    if (!event.success) {
      process.stderr.write(`Error: ${event.error}\n`);
      proc.stdin.end();
      process.exit(1);
    }
  }
});

// Stderr passthrough (only in verbose mode)
proc.stderr.on("data", (chunk) => {
  if (verbose) process.stderr.write(chunk);
});

// ── Handle process lifecycle ───────────────

proc.on("close", (code) => {
  if (!hasPrompted) {
    process.stderr.write(`pi exited with code ${code}\n`);
    process.exit(code);
  }
});

proc.on("error", (err) => {
  process.stderr.write(`Failed to spawn pi: ${err.message}\n`);
  process.exit(1);
});

// SIGINT → abort the agent
process.on("SIGINT", () => {
  send({ type: "abort" });
  // Give it a moment to abort, then kill
  setTimeout(() => {
    if (!agentDone) proc.kill("SIGTERM");
    process.exit(130);
  }, 2000);
});

// ── Startup sequence ────────────────────────

// Wait for pi to be ready, then send the prompt
setTimeout(() => {
  if (promptText) {
    send({ type: "prompt", message: promptText });
    hasPrompted = true;
  } else {
    // No prompt text: interactive mode (read from stdin)
    hasPrompted = false;
    process.stderr.write("aph: no prompt provided. Send JSON commands to stdin.\n");
    process.stderr.write('Example: {"type":"prompt","message":"Hello"}\n');

    // Forward stdin to pi as raw JSONL
    process.stdin.setEncoding("utf-8");
    process.stdin.on("data", (chunk) => {
      send(JSON.parse(chunk));
    });
    process.stdin.on("end", () => {
      proc.stdin.end();
    });
  }
}, 1000); // Give pi time to start
