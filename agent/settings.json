{
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-web-access@0.10.7",
    "npm:pi-context-cap",
    "npm:pi-windsurf",
    "git:github.com/ktappdev/picode",
    "npm:pi-startup-header",
    "npm:@firstpick/pi-extension-git-footer-status",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-opencode-go-cache",
    "git:github.com/ktappdev/pi-chrome",
    "git:github.com/ktappdev/pitrix",
    "npm:@narumitw/pi-chrome-devtools",
    "npm:@underactive/pi-topping-statusline",
    "npm:pi-context-condense",
    "npm:pi-better-models",
    "git:github.com/ktappdev/pi-commandcode-provider",
    "git:github.com/ktappdev/pi-voice",
    "npm:@narumitw/pi-worktree",
    "npm:pi-subagents",
    "npm:pi-cache-optimizer",
    "git:github.com/ktappdev/pi-auto-router"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "theme": "tokyo-night",
  "defaultTools": [
    "+codemode"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 5000
  },
  "lastChangelogVersion": "1.5.0",
  "followUpMode": "all",
  "steeringMode": "all",
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "worker": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "reviewer": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "researcher": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "delegate": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "oracle": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  },
  "cacheWarming": "off",
  "showCacheMissNotices": false,
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-luna": "max"
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol",
    "commandcode/gpt-6-luna",
    "commandcode/z-ai/glm-5.3-flash",
    "commandcode/deepseek/deepseek-v4.1-flash",
    "commandcode/meta/muse-spark-1.3-contributor",
    "commandcode/poolside/laguna-s-2.1-free",
    "commandcode/stepfun/Step-5-Preview"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access@0.10.7\",\"scope\":\"user\"}": "0.10.7",
    "{\"source\":\"git:github.com/ktappdev/picode\",\"scope\":\"user\"}": "0.6.0",
    "{\"source\":\"git:github.com/ktappdev/pi-chrome\",\"scope\":\"user\"}": "0.15.46",
    "{\"source\":\"git:github.com/ktappdev/pitrix\",\"scope\":\"user\"}": "0.5.19",
    "{\"source\":\"git:github.com/ktappdev/pi-commandcode-provider\",\"scope\":\"user\"}": "0.7.2",
    "{\"source\":\"git:github.com/ktappdev/pi-voice\",\"scope\":\"user\"}": "3.0.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.83.0",
    "{\"source\":\"git:github.com/ktappdev/pi-auto-router\",\"scope\":\"user\"}": "0.3.0"
  }
}