{
  "lastChangelogVersion": "0.73.1",
  "theme": "synthwave",
  "defaultThinkingLevel": "medium",
  "agentTeamViewMode": "grid",
  "packages": [
    "git:github.com/ktappdev/pi-telegram",
    "npm:pi-web-access",
    "git:github.com/ktappdev/kilo-pi-provider",
    "git:github.com/jonjonrankin/pi-caveman",
