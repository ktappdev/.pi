{
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "packages": [
    "git:github.com/ktappdev/pi-commandcode-provider"
  ],
  "defaultProvider": "commandcode",
  "defaultModel": "tencent/Hy3",
  "enabledModels": [
    "deepseek/*",
    "lugetech/*"
  ],
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 4096,
    "keepRecentTokens": 8000
  },
  "lastChangelogVersion": "0.80.2"
}